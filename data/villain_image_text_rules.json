{
  "db_name": "Villain Image Text Rules",
  "version": "0.1.0",
  "purpose": "Villain画像内コピーの優先順位と禁止表現を定義する。",
  "symbolic_phrase": {
    "primary_copy": "着て稼ぐ",
    "meaning": "Villainコミュニティの合言葉・思想コピーとして扱う。利益保証や投資助言ではない。",
    "must_be_treated_as_main_copy": true
  },
  "copy_priority": [
    "着て稼ぐ",
    "$villain",
    "WEAR THE VILLAIN",
    "WEAR. BUILD. EARN.",
    "$villain community"
  ],
  "default_copy_set": [
    "着て稼ぐ",
    "$villain"
  ],
  "layout_rules": {
    "max_text_elements": 2,
    "default_pair": "着て稼ぐ + $villain",
    "poster_mode": {
      "primary_copy_position": "large center or upper area",
      "secondary_copy_position": "small logo/signature/neon sign"
    },
    "observer_mode": {
      "primary_copy_position": "distant neon sign or natural back print",
      "secondary_copy_position": "small logo/signature/neon sign"
    }
  },
  "risk_policy": {
    "treat_as": "community slogan and worldview copy",
    "avoid_financial_ad_framing": true,
    "avoid_investment_advice": true,
    "avoid_profit_guarantee": true
  },
  "ng_expressions": [
    "必ず稼げる",
    "利益保証",
    " guaranteed profit ",
    "guaranteed profit",
    "risk-free profit",
    "投資助言",
    "確実に儲かる",
    "買えば稼げる"
  ]
}
