{
  "db_name": "Villain投稿キューDB",
  "version": "0.1.0",
  "created_at": "2026-05-10",
  "purpose": "Codexが生成したVillain投稿案を、投稿実行前のキューとして保存する。Codexはキュー投入まで。投稿実行はしない。",
  "queue_policy": {
    "auto_post_enabled": false,
    "manual_approval_required": true,
    "posting_execution_allowed": false,
    "default_new_item_status": "draft_generated",
    "approval_owner": "大将",
    "codex_allowed_actions": [
      "draft_generatedとして追加",
      "waiting_for_imageへ進めるための画像案記録",
      "投稿前チェックのunchecked/pass/fail記録",
      "skip_day_policy該当時のskipped記録"
    ],
    "codex_forbidden_actions": [
      "approvedへ変更する",
      "postedへ変更する",
      "X投稿を実行する",
      "投稿ボタンを押す",
      "画像なしで投稿可能判定にする"
    ]
  },
  "allowed_statuses": [
    "draft_generated",
    "waiting_for_image",
    "waiting_for_approval",
    "approved",
    "posted",
    "skipped",
    "rejected"
  ],
  "status_transition_rules": [
    {
      "from": "draft_generated",
      "to": "waiting_for_image",
      "allowed_when": [
        "draft_text_exists",
        "passcode_selected",
        "source_urls_listed"
      ]
    },
    {
      "from": "waiting_for_image",
      "to": "waiting_for_approval",
      "allowed_when": [
        "image_attached_pass",
        "source_url_confirmed_pass",
        "passcode_confirmed_pass",
        "prohibited_content_check_pass",
        "skip_day_policy_false"
      ]
    },
    {
      "from": "waiting_for_approval",
      "to": "approved",
      "allowed_when": [
        "daisho_approval_approved"
      ],
      "actor_required": "大将"
    },
    {
      "from": "approved",
      "to": "posted",
      "allowed_when": [
        "operator_manually_posted",
        "posted_url_recorded"
      ],
      "actor_required": "大将または人間オペレーター"
    }
  ],
  "queue_item_template": {
    "queue_id": "",
    "created_at": "",
    "updated_at": "",
