    "source_urls": [],
    "image": {
      "file_path_or_url": "",
      "source": "",
      "rights_notes": ""
    },
    "approval": {
      "approved_by": "大将",
      "approved_at": "",
      "approval_comment": ""
    },
    "final_checks": {
      "source_url_confirmed": "pass",
      "image_attached": "pass",
      "passcode_confirmed": "pass",
      "prohibited_content_check": "pass",
      "skip_day_policy": false,
      "daisho_approval": "approved"
    },
    "reaction_record": {
      "recorded_at": "",
      "likes": null,
      "reposts": null,
      "replies": null,
      "bookmarks_or_save_feel": "",
      "profile_or_link_reaction": "",
