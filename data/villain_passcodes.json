{
  "db_name": "Villain Passcode運用DB",
  "version": "1.1.0",
  "created_at": "2026-05-09",
  "purpose": "公開前提の購入導線または特典コードとして使うPasscodeをローテーション管理する。",
  "policy": {
    "public_use": true,
    "posting_execution_allowed": false,
    "purchase_path_hint_allowed": true,
    "strict_order_required": false,
    "duplicate_use_allowed": true,
    "new_code_addition_allowed": true,
    "human_confirmation_before_publish": true,
    "usage_log_required_on_draft_generation": true,
    "notes": "Passcodeは投稿案の最後に置く。順番は厳密でなくてよい。投稿案生成時点で使用候補コードをusage_logへ記録する。"
  },
  "footer_format": {
    "required": true,
    "exact_shape": "#着て稼ぐ #villain @0xmavillain {PASSCODE}",
    "placement": "投稿本文の最終行"
  },
  "selection_rules": [
    {
      "name": "default_rotation",
      "rule": "直近使用が少ないものを優先する。"
    },
    {
      "name": "campaign_override",
      "rule": "キャンペーンや人間指定がある場合は指定Passcodeを優先する。"
    },
    {
      "name": "duplicate_ok",
      "rule": "被りは許可。ただし同日連投で同じコードが続く場合は確認する。"
    },
    {
      "name": "public_copy",
      "rule": "隠しコードではなく、公開された購入導線/特典コードとして扱う。"
    }
  ],
